# Multi-stage build for the xbvr fork.
# Stage 1 builds the Vue UI, stage 2 compiles the Go binary (CGO/sqlite) with the UI
# embedded, stage 3 is a slim runtime. trixie is used in the build and runtime stages so
# the CGO binary's glibc matches. Live transcoding runs the jellyfin-ffmpeg build XBVR
# downloads into its config folder, so no ffmpeg is built here.
#
#   docker build -f Dockerfile.build -t xbvr:recommend .

### Stage 1 — build the Vue UI into ui/dist
FROM node:24-bookworm AS ui
WORKDIR /src
ENV NODE_OPTIONS=--max-old-space-size=4096
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --ignore-engines --network-timeout 600000
COPY . .
RUN yarn build

### Stage 2 — build the Go binary with the embedded UI (CGO for go-sqlite3)
FROM golang:1.26-trixie AS build
WORKDIR /src
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev curl ca-certificates unzip \
    && rm -rf /var/lib/apt/lists/*
# ONNX Runtime (for visual embeddings) from its NuGet package, plus a small pretrained
# MobileNetV2 model.
ARG ONNXRUNTIME_VERSION=1.26.0
ARG ONNXRUNTIME_SHA256=50cc3772668f04b8373ad65a36793f94699bc4e818f6e691fc68f1578c38ce42
RUN mkdir -p /opt/onnx \
    && curl -fsSL "https://api.nuget.org/v3-flatcontainer/microsoft.ml.onnxruntime/${ONNXRUNTIME_VERSION}/microsoft.ml.onnxruntime.${ONNXRUNTIME_VERSION}.nupkg" -o /tmp/ort.nupkg \
    && echo "${ONNXRUNTIME_SHA256}  /tmp/ort.nupkg" | sha256sum -c - \
    && unzip -q -j /tmp/ort.nupkg runtimes/linux-x64/native/libonnxruntime.so -d /opt/onnx \
    && curl -fsSL https://github.com/onnx/models/raw/main/validated/vision/classification/mobilenet/model/mobilenetv2-7.onnx -o /opt/onnx/mobilenet.onnx
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=ui /src/ui/dist ./ui/dist
ARG VERSION=0.4.40.28
RUN CGO_ENABLED=1 go build -tags=json1 \
    -ldflags="-s -w -X main.version=${VERSION}" \
    -o /xbvr .

### Stage 3 — runtime (drop-in for the official image)
FROM debian:trixie-slim
# python3 is used by the deploy checks and helper scripts, and ffmpeg is the one on the PATH
# for DLNA transcoding. jellyfin-ffmpeg needs the GPU drivers from the system: NVIDIA's are
# injected by the NVIDIA container runtime; these packages add AMD's Mesa VAAPI driver and
# Intel's VAAPI drivers and oneVPL runtime. Quick Sync encoding needs Intel's non-free media
# driver, and jellyfin-ffmpeg needs libva 2.21 or newer to send frames to the GPU, which
# bookworm does not have. Hosts still have to pass their GPU device nodes into the container.
RUN sed -i 's/^Components: main$/Components: main non-free/' /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
        python3 ca-certificates iproute2 ffmpeg \
        libva2 libva-drm2 libvpl2 libmfx-gen1.2 \
        mesa-va-drivers intel-media-va-driver-non-free i965-va-driver \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /xbvr /usr/bin/xbvr
COPY --from=build /opt/onnx/libonnxruntime.so /usr/lib/libonnxruntime.so
COPY --from=build /opt/onnx/mobilenet.onnx /usr/share/xbvr/mobilenet.onnx
RUN ldconfig
COPY xbvr_data/ /usr/bin/xbvr_data/
COPY docker_start.sh /
RUN chmod 777 /docker_start.sh
EXPOSE 9998-9999
VOLUME /root/.config/
CMD ["/usr/bin/xbvr"]
